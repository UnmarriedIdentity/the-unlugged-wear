{
  "name": "the-unplugged-wear",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev:admin": "pnpm --dir tuw-admin dev",
    "build:admin": "pnpm --dir tuw-admin build",
    "start:admin": "pnpm --dir tuw-admin start",
    "typecheck:admin": "pnpm --dir tuw-admin typecheck",
    "dev:website": "pnpm --dir tuw-website dev",
    "build:website": "pnpm --dir tuw-website build",
    "start:website": "pnpm --dir tuw-website start",
    "typecheck:website": "pnpm --dir tuw-website typecheck",
    "typecheck": "pnpm run typecheck:admin && pnpm run typecheck:website && pnpm run typecheck:heart",
    "test:admin": "pnpm --dir tuw-admin test",
    "test:website": "pnpm --dir tuw-website test",
    "test": "pnpm run test:admin && pnpm run test:website && pnpm run test:heart",
    "build": "pnpm run build:admin && pnpm run build:website",
    "db:status": "node --env-file-if-exists=.env.local db/scripts/db.mjs status",
    "db:migrate": "node --env-file-if-exists=.env.local db/scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local db/scripts/db.mjs seed",
    "db:reset": "node --env-file-if-exists=.env.local db/scripts/db.mjs reset",
    "typecheck:heart": "pnpm --dir packages/heart typecheck",
    "test:heart": "pnpm --dir packages/heart test",
    "db:types": "pnpm --dir packages/heart exec node --env-file-if-exists=../../.env.local node_modules/drizzle-kit/bin.cjs pull --config drizzle.config.ts && node packages/heart/scripts/fix-generated.mjs",
    "auth:bootstrap-admin": "node --env-file-if-exists=.env.local --conditions=react-server packages/heart/scripts/bootstrap-admin.ts",
    "db:seed-catalog": "node --env-file-if-exists=.env.local --conditions=react-server packages/heart/scripts/seed-demo-catalog.ts"
  },
  "devDependencies": {
    "pg": "8.13.1"
  }
}
