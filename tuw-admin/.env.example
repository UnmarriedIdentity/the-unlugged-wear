# Safe placeholders only. Do not commit real secrets.
# Neon Postgres (shared by tuw-admin and tuw-website). Server only.
# Pooled connection string for the app; the unpooled one is for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Session/JWT signing secret for this app (never shared with the browser).
AUTH_SECRET=
# Vercel Cron → /api/cron/<job> (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=
# Shared with the storefront: admin edits refresh storefront caches.
REVALIDATE_SECRET=
STOREFRONT_URL=http://localhost:3007
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
